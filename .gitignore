# ==============================================================================
# LoanPilot — Master .gitignore
# Prevents exposure of secrets, credentials, databases, documents, PII & cache
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SECRETS, API KEYS & ENVIRONMENT VARIABLES (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
backend/.env
frontend/.env
!*.env.example
!.env.example

# Private keys, certificates, credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.pub
secrets.json
credentials.json
service_account*.json
token.json
client_secrets.json

# ------------------------------------------------------------------------------
# 2. APPLICATION DATA, UPLOADS & GENERATED ASSETS (PII PROTECTION)
# ------------------------------------------------------------------------------
# Upload directories & submitted loan documents
uploads/
backend/uploads/
**/uploads/
*.pdf
*.jpg
*.jpeg
*.png
*.tiff
*.tif

# Generated test/dummy data & Kaggle raw datasets
data/kaggle/*.csv
data/kaggle/*.zip
data/generated/
data/sample_applications/*
!data/sample_applications/.gitkeep

# Generated audit & verification reports
backend/reports/
**/reports/*.pdf
**/reports/*.html

# ------------------------------------------------------------------------------
# 3. DATABASES & STORAGE ENGINES
# ------------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
loanpilot.db
backend/loanpilot.db

# ------------------------------------------------------------------------------
# 4. PYTHON (BACKEND & SCRIPTS)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
**/*.pyc

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/.venv/

# Distribution & Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
!frontend/src/lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing & Coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/
htmlcov/

# Type checking & Linting
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.dmypy.json
dmypy.json

# Jupyter / IPython
.ipynb_checkpoints
*/.ipynb_checkpoints/*
profile_default/
ipython_config.py

# ------------------------------------------------------------------------------
# 5. NODE.JS & FRONTEND (REACT / VITE)
# ------------------------------------------------------------------------------
node_modules/
frontend/node_modules/
.pnp
.pnp.js
.pnpm-store/

# Build outputs
frontend/dist/
dist/
dist-ssr/
out/
.next/
.nuxt/

# Vite caches
.vite/
frontend/.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Linters
.eslintcache
.stylelintcache
.oxlintcache

# ------------------------------------------------------------------------------
# 6. OPERATING SYSTEM & EDITOR SPECIFICS
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# Editors (VSCode, JetBrains, Vim)
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# ------------------------------------------------------------------------------
# 7. DOCKER & MISCELLANEOUS
# ------------------------------------------------------------------------------
.docker/
*.pid
*.seed
*.pid.lock
scratch/
